# Keep placeholders in committed files. Use your real values only in local .env.
IMMICH_SERVER_URL=https://your-immich-host.example.com
# IMMICH_LIBRARIES is a JSON object mapping library names to their API keys.
IMMICH_LIBRARIES={"family_library":"replace-with-api-key"}
# Photo Provider: immich (default)
PHOTO_PROVIDER=immich
APP_HOST=127.0.0.1
APP_PORT=8010
# UI language: en-US (English, default) or pt-BR (Brazilian Portuguese)
LANGUAGE=en-US

# Access control & authentication mode: disabled (default, everyone is Creator) or cloudflare
AUTH_MODE=disabled
# Comma-separated list of Cloudflare Access emails granted Creator privileges (host games, manage libraries, moderate)
CF_CREATOR_EMAILS=
# Comma-separated list of Cloudflare Access emails granted User privileges (join challenges, view player stats & replays)
CF_USER_EMAILS=
# Enforce verified Cloudflare Access name as player name in challenges (true/false, default: false)
CF_LOCK_PLAYER_NAME=false

# Base data directory where metadata.db and leaderboard.db are stored (default: data)
DATA_PATH=data
# Automatically trigger background metadata indexing on server startup (true/false)
AUTO_SYNC_ON_STARTUP=true
# Optional periodic sync interval in hours (0 disables)
AUTO_DELTA_SYNC_INTERVAL_HOURS=6
AUTO_FULL_SYNC_INTERVAL_HOURS=120
# Cooldown period in seconds between manual sync triggers (0 disables; default: 60)
SYNC_COOLDOWN_SECONDS=60

# Logging verbosity: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed countries (empty = allow all available)
COUNTRY_WHITELIST=
# Comma-separated list of excluded countries
COUNTRY_BLACKLIST=

# Comma-separated list of allowed cities/regions (empty = allow all available)
CITY_WHITELIST=
# Comma-separated list of excluded cities/regions
CITY_BLACKLIST=

# Comma-separated list of allowed person names or IDs (empty = allow all named people)
PEOPLE_WHITELIST=
# Comma-separated list of excluded person names or IDs
PEOPLE_BLACKLIST=

# Comma-separated list of allowed asset tag names or IDs (empty = allow all tags)
TAG_WHITELIST=
# Comma-separated list of excluded asset tag names or IDs
TAG_BLACKLIST=
# Exclude reported/flagged photos with metadata inconsistencies from question pools (true/false, default: true)
EXCLUDE_FLAGGED_ASSETS=true
# Optional date bounds for photos eligible to be fetched into rounds (YYYY-MM-DD)
DATE_LOWER_BOUND=
DATE_UPPER_BOUND=

# Map tile endpoints & attributions (optional overrides for custom, Mapbox, or offline tile servers)
TILE_URL_STREETS=
TILE_ATTRIBUTION_STREETS=
TILE_URL_SATELLITE=
TILE_URL_HYBRID_BOUNDARIES=
TILE_URL_HYBRID_ROADS=
TILE_ATTRIBUTION_SATELLITE=
